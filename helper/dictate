# ~/.config/dictate/privacy (written by the settings window, format: extension/keys.js):
#   history = on|off       keep the last HISTORY_N recordings for the top-bar menu
#   keep_minutes = N       delete kept recordings (history and failed ones) after N minutes; 0 = until restart
#   keep_audio = on|off    the history keeps the audio too (RAM only), so a text can be transcribed again
PRIVACY_FILE = os.path.expanduser("~/.config/dictate/privacy")
MAX_TEXT = 50000                       # 15 min of speech is ~20 000 characters


def privacy():
    p = {"history": True, "keep_minutes": 60, "keep_audio": False}
    try:
        with open(PRIVACY_FILE) as f:
            for line in f:
                m = re.fullmatch(r"\s*(history|keep_minutes|keep_audio)\s*=\s*(\S+)\s*", line)
                if m and m[1] == "history":
                    p["history"] = m[2] != "off"
                elif m and m[1] == "keep_audio":
                    p["keep_audio"] = m[2] == "on"
                elif m and m[2].isdigit():
                    p["keep_minutes"] = int(m[2])
    except OSError:
        pass
    return p


# ~/.config/dictate/speech (written by the settings window, format: extension/keys.js):
#   languages = uk en ru    the enabled languages, main first
#   margin = 0.15           how much surer another Cyrillic language must be than the main one
#   threads = 0             CPU threads for the model; 0 = automatic
#   final_period = keep|drop|chats   no "." at the end: never / always / in chats and terminals (the
#                           extension knows the app, it does "chats")
#   spoken_punctuation = off|on   say "кома", "знак питання", "новий рядок"... (uk, ru, en)
#   fillers = on|off        remove hesitation sounds: "еее", "ммм", "um", "uh"
#   space_after = on|off    (used by the extension: a space after the typed text)
#   microphone = default    or a PipeWire source name (node.name in pw-dump)
#   auto_stop = 0           finish by itself after this many seconds of silence (0 = never)
#   voice_gate = off|light|medium|strong   mute sound much quieter than your voice (other people)
#   pill = bottom|top       (used by the extension)
#   model = int8|fp32       which model variant to use (if it is installed; else the other one)
# ~/.config/dictate/replacements: "words = replacement" per line, applied to every text
SPEECH_FILE = os.path.expanduser("~/.config/dictate/speech")
# How much surer a candidate language must be on top of `margin`, by (candidate, main language): the
# model leans to some languages. Measured on Ukrainian dictation (one speaker, laptop and headset):
# decoded as Russian it scored up to +0.52/s better than as Ukrainian, so Russian needs that much more
# before it replaces Ukrainian. Pairs not listed are not known to lean: margin alone.
LANG_BIAS = {("ru", "uk"): 0.45}
# voice_gate: sound this many dB below your own voice is muted before recognition
GATE_DB = {"off": 0, "light": 25, "medium": 18, "strong": 12}
REPLACE_FILE = os.path.expanduser("~/.config/dictate/replacements")


def speech():
    p = {"languages": ["uk", "en", "ru"], "margin": 0.15, "threads": 0, "final_period": "keep",
         "microphone": "default", "auto_stop": 0, "voice_gate": "off", "spoken_punctuation": False,
         "fillers": True, "model": "int8"}
    try:
        with open(SPEECH_FILE) as f:
            for line in f:
                m = re.fullmatch(r"\s*(languages|margin|threads|final_period|microphone|auto_stop|voice_gate"
                                 r"|spoken_punctuation|fillers|model)"
                                 r"\s*=\s*(.*?)\s*", line)
                if not m:
                    continue
                k, v = m[1], m[2]
                try:
                    if k == "languages":
                        langs = [c for c in dict.fromkeys(v.replace(",", " ").split()) if c in LANGS]
                        p[k] = langs or p[k]
                    elif k == "margin":
                        p[k] = min(2.0, max(0.0, float(v)))
                    elif k == "threads":
                        p[k] = min(64, max(0, int(v)))
                    elif k == "auto_stop":
                        p[k] = min(60, max(0, int(v)))
                    elif k == "microphone":
                        p[k] = v if re.fullmatch(r"[\w.:@+-]+", v) else "default"
                    elif k == "voice_gate":
                        p[k] = v if v in GATE_DB else "off"
                    elif k in ("spoken_punctuation", "fillers"):
                        p[k] = v == "on"
                    elif k == "model":
                        p[k] = v if v in VARIANTS else "int8"
                    elif v in ("keep", "drop", "chats"):
                        p[k] = v
                except ValueError:
                    pass
    except OSError:
        pass
    return p


def replacements():
    """[(compiled pattern, replacement)] from ~/.config/dictate/replacements; whole words, any case"""
    out_ = []
    try:
        with open(REPLACE_FILE, encoding="utf-8") as f:
            for line in f:
                line = line.strip()
                if not line or line.startswith("#") or "=" not in line:
                    continue
                a, b = (x.strip() for x in line.split("=", 1))
                if a:
                    out_.append((re.compile(r"(?<!\w)" + re.escape(a) + r"(?!\w)", re.I), b))
    except OSError:
        pass
    return out_


# A line break the user asked for ("новий рядок"): a private-use character, not "\n", so that every
# cleaning step keeps it; the extension turns it into a line break, or into a space in a terminal (a
# line break there would run a command).
NEWLINE_MARK = "\ue000"
# spoken punctuation, per language: phrase -> what it becomes (longer phrases first)
SPOKEN = {
    "uk": [("крапка з комою", ";"), ("знак питання", "?"), ("знак оклику", "!"), ("двокрапка", ":"),
           ("новий абзац", "\n\n"), ("новий рядок", "\n"), ("кома", ","), ("крапка", "."), ("тире", "—")],
    "ru": [("точка с запятой", ";"), ("вопросительный знак", "?"), ("знак вопроса", "?"),
           ("восклицательный знак", "!"), ("двоеточие", ":"), ("новый абзац", "\n\n"),
           ("новая строка", "\n"), ("запятая", ","), ("точка", "."), ("тире", "—")],
    "en": [("question mark", "?"), ("exclamation mark", "!"), ("exclamation point", "!"),
           ("semicolon", ";"), ("colon", ":"), ("new paragraph", "\n\n"), ("new line", "\n"),
           ("comma", ","), ("full stop", "."), ("period", "."), ("dash", "—")],
}
# hesitation sounds only (not words like "ну" / "well", which can carry meaning)
FILLERS = re.compile(r"(?<!\w)(?:е{2,}м*|э{2,}м*|а{2,}|м{2,}|ем{1,}|эм{1,}|хм+|u+h+m*|u+m+|e+r+m+|h+m+|m{2,})(?!\w)"
                     r"[,.]?", re.I)
PUNCT = "[\\s,.;:!?]*"
# where a command word is an ordinary word: "точка зрения", "the period of"
NOT_COMMAND = {"точка": r"(?!\s+(?:зрения|отсч[её]та|опоры|доступа|росы|кипения|замерзания|соприкосновения))",
               "крапка": r"(?!\s+(?:зору|відліку|опори|доступу))", "period": r"(?!\s+of\b)",
               "colon": r"(?!\s+(?:cancer|health)\b)", "dash": r"(?!\s+(?:cam|board)\b)"}


def spoken_punctuation(text, langs):
    for lang in langs:
        for phrase, sym in SPOKEN.get(lang, []):
            words = r"\s+".join(map(re.escape, phrase.split()))
            # a line break keeps the punctuation before it ("справи? новий рядок"), the rest replace it
            lead = r"[\s,]*" if sym.startswith("\n") else PUNCT
            pat = re.compile(lead + r"(?<!\w)" + words + r"(?!\w)" + NOT_COMMAND.get(phrase, "") + PUNCT, re.I)
            if sym.startswith("\n"):
                rep_ = NEWLINE_MARK * len(sym)
            elif sym == "—":
                rep_ = " — "
            else:
                rep_ = sym + " "
            text = pat.sub(lambda m: rep_, text)
    # a capital letter after the end of a sentence or a line break
    text = re.sub(r"([.?!]\s+|" + NEWLINE_MARK + r")(\w)", lambda m: m[1] + m[2].upper(), text)
    return text.strip(" ")


def polish(text, settings=None):
    """The user's text settings: hesitation sounds out, spoken punctuation, word replacements and
    snippets, no final period"""
    settings = settings or speech()
    text = text.replace(NEWLINE_MARK, " ")        # only a spoken command may make a line break
    if settings["fillers"]:
        at_start = bool(FILLERS.match(text.lstrip()))
        text = FILLERS.sub("", text)
        text = re.sub(r"\s+([,.;:!?])", r"\1", " ".join(text.split()))
        text = re.sub(r"^[,.;:]\s*", "", text)
        if at_start:                       # "Еее, привіт" -> "Привіт"
            text = text[:1].upper() + text[1:]
    if settings["spoken_punctuation"]:
        text = spoken_punctuation(text, settings["languages"])
    for pat, rep_ in replacements():
        text = pat.sub(lambda m: rep_, text)
    if settings["final_period"] == "drop" and text.endswith(".") and not text.endswith(".."):
        text = text[:-1]
    # spaces around a line break are not wanted
    text = re.sub(r" *(" + NEWLINE_MARK + r"+) *", r"\1", text)
    return clean(text)


# Speech gives one line of words. Control characters (line breaks, ESC sequences), zero-width and
# bidi-override characters cannot come from it: they are cut, so that even a tampered model cannot
# make the paste run a command in a terminal or hide text (the extension cleans the text again).
_BAD_CHARS = re.compile("[\x00-\x1f\x7f-\x9f\u200b-\u200f\u2028\u2029\u202a-\u202e\u2066-\u2069\ufeff]")


def clean(text):
    if not isinstance(text, str):
        return ""
    return " ".join(_BAD_CHARS.sub(" ", text).split())[:MAX_TEXT]


def out(line):
    sys.stdout.write(line + "\n")
    sys.stdout.flush()


def log(msg):
    os.makedirs(os.path.dirname(LOG_FILE), exist_ok=True)
    with open(LOG_FILE, "a") as f:
        f.write(time.strftime("%F %T ") + msg + "\n")


class Fail(Exception):
    pass


# ------------------------------------------------------------------ recording
LIVE_NONZERO = 0.25             # a chunk with at least this share of non-zero samples = the mic really works


def pw_record(extra):
    proc = subprocess.Popen(["pw-record", "--raw", "--rate", str(RATE), "--channels", "1", "--format", "s16"]
                            + extra + ["-"], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
    os.set_blocking(proc.stdout.fileno(), False)
    return proc


def pw_sources():
    """([(name, description)] of the microphones, the default one's name), from PipeWire (pw-dump)."""
    try:
        objs = json.loads(subprocess.run(["pw-dump"], capture_output=True, text=True, timeout=3).stdout)
    except (OSError, subprocess.SubprocessError, ValueError):
        return [], ""
    mics, default = [], ""
    for o in objs:
        props = (o.get("info") or {}).get("props") or {}
        if props.get("media.class") == "Audio/Source" and props.get("node.name"):
            mics.append((props["node.name"], props.get("node.description") or props["node.name"]))
        if (o.get("props") or {}).get("metadata.name") == "default":
            for m in o.get("metadata") or []:
                if m.get("key") == "default.audio.source" and isinstance(m.get("value"), dict):
                    default = m["value"].get("name") or ""
    return mics, default


def builtin_mic():
    """The first wired/built-in microphone (not Bluetooth)."""
    return next((n for n, _ in pw_sources()[0] if not n.startswith("bluez_")), None)


def sources():
    """names of the microphones"""
    return [n for n, _ in pw_sources()[0]]


def default_source():
    return pw_sources()[1]


def is_live(chunk):
    a = array.array("h")
    a.frombytes(chunk)
    return sum(1 for x in a if x) >= LIVE_NONZERO * max(len(a), 1)


def stop_proc(proc):
    if proc is None:
        return
    proc.terminate()
    try:
        proc.wait(2)
    except subprocess.TimeoutExpired:
        proc.kill()


def cut(raw, spans):
    """raw without the paused [start, end) byte spans (end None = paused until the stop)."""
    keep, pos = bytearray(), 0
    for a, b in spans:
        a = min(a, len(raw)) & ~1
        b = len(raw) if b is None else min(b, len(raw)) & ~1
        if a > pos:
            keep += raw[pos:a]
        pos = max(pos, b)
    keep += raw[pos:]
    return bytes(keep)


def record(streamer=None):
    """Returns raw s16 mono audio, or None when cancelled.
    streamer: gets the audio while it is recorded (exactly the bytes that will be returned, paused
    stretches cut out), so it can transcribe pieces in the background; finish() checks it got them.
    Pause: the microphones keep running (no headset re-switch, no gap in time), the paused stretches
    are remembered as byte positions and cut out at the end.
    Bluetooth headset: recording makes WirePlumber switch it from music mode (A2DP) to headset mode
    (HFP), which takes ~1 s or more, and until then its mic gives only zeros: the first words were
    lost. So the built-in mic records too, and the recording starts with the built-in mic until the
    headset mic gives real sound (if it never does, the built-in mic is used for all of it).
    Microphone: the one chosen in Settings (if it is still there), else the system default.
    Auto-stop (Settings): after you spoke, this many seconds of silence finish the recording."""
    sp = speech()
    mic = sp["microphone"]
    if mic != "default" and mic not in sources():
        log("chosen microphone not found, using the default one")
        mic = "default"
    target = ["--target", mic] if mic != "default" else []
    proc = pw_record(target + ["--media-role", "Communication", "-P", "{ node.name = dictate }"])
    bridge = None
    if (mic if mic != "default" else default_source()).startswith("bluez_"):
        mic = builtin_mic()
        if mic:
            bridge = pw_record(["--target", mic, "-P", "{ node.name = dictate-bridge }"])
    os.set_blocking(sys.stdin.fileno(), False)
    sel = selectors.DefaultSelector()
    sel.register(proc.stdout, selectors.EVENT_READ, "mic")
    if bridge:
        sel.register(bridge.stdout, selectors.EVENT_READ, "bridge")
    sel.register(sys.stdin, selectors.EVENT_READ, "cmd")
    audio, pending, cmd_buf = bytearray(), b"", b""
    early, early_pending = bytearray(), b""          # built-in mic until the headset mic is live
    live = None if bridge else 0                     # byte offset in audio where the main mic went live
    meter = Meter()
    early_meter = Meter() if bridge else None
    start = time.monotonic()
    paused = None                                    # (main pos, early pos) where the pause began
    spans_main, spans_early = [], []                 # paused byte spans in audio / in early
    paused_s, paused_at = 0.0, 0.0
    voice = {"chunks": 0, "at": time.monotonic()}  # voiced 50 ms chunks so far, when voice was last heard
    fed = 0                                          # position in audio up to which the streamer has it
    head = b""                                       # built-in mic audio before `live` (headset case)

    def src(a, b):
        """audio[a:b] as it will be returned: the built-in mic before `live`, the main mic after"""
        if a >= live:
            return audio[a:b]
        return head[a:min(b, live)] + audio[max(a, live):b]

    def feed():
        """Give the streamer what is new, with the same cuts as cut(). Only once it is known which
        microphone the start comes from (a headset mic that is not live yet: wait)."""
        nonlocal fed
        if streamer is None or live is None:
            return
        end, pos = len(audio), fed
        for a, b in spans_main + ([(paused[0], None)] if paused is not None else []):
            a, b = a & ~1, end if b is None else b & ~1
            if b <= pos:
                continue
            if a >= end:
                break
            if a > pos:
                streamer.feed(src(pos, a))
            pos = max(pos, b)
        if pos < end:
            streamer.feed(src(pos, end))
        fed = max(pos, end)

    def level(v):
        out(f"L {v:.3f}")
        if v > 0:
            voice["chunks"] += 1
            voice["at"] = time.monotonic()

    try:
        while True:
            now = time.monotonic()
            if now - start > MAX_WALL_SECONDS or \
                    now - start - paused_s - (now - paused_at if paused else 0) > MAX_SECONDS:
                break
            if sp["auto_stop"] and paused is None and voice["chunks"] >= 10 \
                    and now - voice["at"] > sp["auto_stop"]:
                log(f"auto-stop after {sp['auto_stop']}s of silence")
                break
            for key, _ in sel.select(timeout=0.5):
                if key.data == "cmd":
                    data = os.read(sys.stdin.fileno(), 256)
                    if not data:                      # extension went away
                        return None
                    cmd_buf += data
                    *lines, cmd_buf = cmd_buf.split(b"\n")
                    for c in lines:
                        c = c.strip()
                        if c == b"cancel":
                            return None
                        if c == b"stop":
                            raise StopIteration
                        if c == b"pause" and paused is None:
                            paused = (len(audio) + len(pending), len(early))
                            paused_at = time.monotonic()
                        elif c == b"resume" and paused is not None:
                            spans_main.append((paused[0], len(audio) + len(pending)))
                            spans_early.append((paused[1], len(early)))
                            paused_s += time.monotonic() - paused_at
                            paused = None
                            voice["at"] = time.monotonic()      # silence counts from the resume
                elif key.data == "bridge":
                    try:
                        data = os.read(bridge.stdout.fileno(), 65536)
                    except BlockingIOError:
                        continue
                    if not data:                      # built-in mic gone: just wait for the headset
                        sel.unregister(bridge.stdout)
                        continue
                    early += data
                    early_pending += data
                    while len(early_pending) >= CHUNK:
                        if live is None and paused is None:   # the bars show the built-in mic meanwhile
                            level(early_meter.level(early_pending[:CHUNK]))
                        early_pending = early_pending[CHUNK:]
                else:
                    try:
                        data = os.read(proc.stdout.fileno(), 65536)
                    except BlockingIOError:
                        continue
                    if not data:
                        if live is None and early:    # headset mic never worked: keep the built-in one
                            sel.unregister(proc.stdout)
                            continue
                        raise Fail("Microphone stopped")
                    pending += data
                    while len(pending) >= CHUNK:
                        chunk, pending = pending[:CHUNK], pending[CHUNK:]
                        if live is None and is_live(chunk):
                            live = len(audio)
                            log(f"headset mic live after {live / 2 / RATE:.2f}s, built-in mic used until then")
                            try:
                                sel.unregister(bridge.stdout)
                            except KeyError:
                                pass
                            stop_proc(bridge)
                            bridge = None
                            head = bytes(early[:live])
                            head += bytes(audio[len(head):live])   # built-in mic started late: zeros
                        audio += chunk
                        if live is not None and paused is None:
                            level(meter.level(chunk))
                    feed()
    except StopIteration:
        pass
    finally:
        try:
            if meter.stats():
                log(meter.stats())
        except Exception:
            pass
        stop_proc(proc)
        stop_proc(bridge)
    audio += pending
    if paused is not None:                            # stopped while paused
        spans_main.append((paused[0], None))
        spans_early.append((paused[1], None))
    if spans_main:
        cut_s = sum(((len(audio) if b is None else b) - a) for a, b in spans_main) / 2 / RATE
        log(f"paused {len(spans_main)}x, {cut_s:.1f}s cut out")
    if live is None:                                  # headset mic gave no sound at all
        if early:
            log(f"headset mic gave no sound in {len(audio) / 2 / RATE:.1f}s, built-in mic used for all")
            return cut(bytes(early), spans_early)
        return cut(bytes(audio), spans_main)
    if live == 0:
        return cut(bytes(audio), spans_main)
    head = early[:live]
    head += audio[len(head):live]                     # built-in mic started late: keep the zeros
    return cut(bytes(head + audio[live:]), spans_main)


class VoiceBand:
    """Mean power of s16 audio in the voice band only (120 Hz high-pass, then 2200 Hz low-pass; this
    also removes DC). Laptop microphones often have a constant DC offset and strong rumble below 80 Hz,
    20+ dB louder than speech; measured in full band every frame looks alike. Keeps its state across
    calls, so the audio must come in order."""

    def __init__(self):
        self.bq = [self._biquad(120, "hp"), self._biquad(2200, "lp")]

    def power(self, a):
        """a: array("h"). Returns the mean square of the filtered samples (s16 units)."""
        acc = 0.0
        (b0, b1, b2, a1, a2, s1), (c0, c1, c2, d1, d2, s2) = self.bq
        x1, x2, y1, y2 = s1
        u1, u2, z1, z2 = s2
        for x in a:
            y = b0 * x + b1 * x1 + b2 * x2 - a1 * y1 - a2 * y2
            x2, x1, y2, y1 = x1, x, y1, y
            z = c0 * y + c1 * u1 + c2 * u2 - d1 * z1 - d2 * z2
            u2, u1, z2, z1 = u1, y, z1, z
            acc += z * z
        s1[:] = [x1, x2, y1, y2]
        s2[:] = [u1, u2, z1, z2]
        return acc / (len(a) or 1)

    @staticmethod
    def _biquad(f0, kind, q=0.7071):
        w = 2 * math.pi * f0 / RATE
        al, cw = math.sin(w) / (2 * q), math.cos(w)
        if kind == "hp":
            b = [(1 + cw) / 2, -(1 + cw), (1 + cw) / 2]
        else:
            b = [(1 - cw) / 2, 1 - cw, (1 - cw) / 2]
        a0 = 1 + al
        return (b[0] / a0, b[1] / a0, b[2] / a0, -2 * cw / a0, (1 - al) / a0, [0.0, 0.0, 0.0, 0.0])


class Meter:
    """Voice level 0..1 per 50 ms chunk: 0 while there is only background noise (fans, room hum),
    so the bars move only when someone speaks. Only the voice band is measured (120-2200 Hz band-pass:
    laptop mics often have strong rumble below 80 Hz; the old pre-emphasis filter cut the voice by ~20 dB at
    200 Hz and kept the fan hiss at 2-4 kHz, so normal speech hardly showed), the noise floor follows
    the room (falls fast, rises only 0.5 dB/s, so fans speeding up are learned but a
    long stretch of speech is not), and sound 5 dB above that floor for at least 100 ms shows.
    The bar scale adapts to the voice on the microphone in use (a laptop mic hears speech ~10-25 dB above the
    fans, a Bluetooth headset ~40-70 dB above its near-silent floor): the top of the bar follows your
    recent loud speech (rises in ~0.5 s, falls 1 dB/s) and the bar shows the 24 dB below it, so normal
    speech is tall, quieter speech lower. Full height (orange in the pill) only when the sound is
    really loud in absolute terms: peaks near full scale (clipping) or very loud level.
    stats() gives numbers for the log (no audio): how far above the floor speech was, so the gate
    and range can be tuned on real recordings."""
    GATE_DB = 5.0
    RISE_DB = 0.025                                    # floor: per 50 ms chunk = 0.5 dB/s
    WINDOW_DB = 24.0                                   # the bar shows this much below the top
    MIN_SPAN_DB = 12.0                                 # top never closer than this to the gate
    REF_FALL_DB = 0.05                                 # top falls 1 dB/s
    TOP = 0.88                                         # highest bar without the orange alarm
    RELEASE = 0.78                                     # bars rise at once, fall smoothly (~0.3 s)
    LOUD_PEAK, LOUD_DB = 31000, -14.0                  # orange: near clipping / very loud

    def __init__(self):
        self.floor = None
        self.ref = None
        self.shown = 0.0
        self.band = VoiceBand()
        self.n = 0
        self.last = 0.0
        self.above = []                                # dB above floor, per chunk (numbers only)
        self.floors = []

    def level(self, chunk):
        a = array.array("h")
        a.frombytes(chunk)
        peak = max(max(a, default=0), -min(a, default=0))
        db = 20 * math.log10(max(math.sqrt(self.band.power(a)), 1) / 32768)
        self.n += 1
        if self.floor is None or self.n <= 6:          # first 0.3 s: learn the room (mic may still settle)
            self.floor = db if self.floor is None else min(self.floor, db)
            return 0.0
        if db < self.floor:
            self.floor += (db - self.floor) * 0.3
        else:
            self.floor += min(self.RISE_DB, (db - self.floor) * 0.02)
        self.above.append(db - self.floor)
        if self.n % 20 == 0:
            self.floors.append(self.floor)
        gate = self.floor + self.GATE_DB
        if db > gate:                                  # top of the scale follows loud speech
            lo = gate + self.MIN_SPAN_DB
            ref = max(self.ref if self.ref is not None else db + 2, lo)   # first voice sets the scale
            self.ref = ref + (db - ref) * 0.35 if db > ref else max(lo, ref - self.REF_FALL_DB)
        elif self.ref is not None:
            self.ref = max(gate + self.MIN_SPAN_DB, self.ref - self.REF_FALL_DB)
        if db <= gate:
            v = 0.0
        elif peak >= self.LOUD_PEAK or db >= self.LOUD_DB:
            v = 1.0
        else:
            bottom = max(gate, self.ref - self.WINDOW_DB)
            v = max(0.06, min(self.TOP, self.TOP * (db - bottom) / (self.ref - bottom)))
        last, self.last = self.last, v
        v = v if last > 0 else 0.0                     # one lone 50 ms click (key, desk) is not speech
        if v < 1.0:                                    # gaps between syllables do not drop the bar to zero
            v = min(self.TOP, max(v, self.shown * self.RELEASE))
        self.shown = v if v >= 0.05 else 0.0
        return self.shown

    def stats(self):
        if len(self.above) < 20:
            return ""
        loud = sorted(x for x in self.above if x > self.GATE_DB)
        q = lambda l, p: l[min(len(l) - 1, int(p * len(l)))] if l else 0.0
        fl = sorted(self.floors) or [self.floor]
        return (f"meter: floor {q(fl, 0.5):.1f} dBFS ({fl[0]:.1f}..{fl[-1]:.1f}), "
                f"voiced {100 * len(loud) / len(self.above):.0f}% of chunks, "
                f"above floor p50 {q(loud, 0.5):.1f} p90 {q(loud, 0.9):.1f} max {q(loud, 1.0):.1f} dB")


def to_wav(raw):
    buf = io.BytesIO()
    with wave.open(buf, "wb") as w:
        w.setnchannels(1)
        w.setsampwidth(2)
        w.setframerate(RATE)
        w.writeframes(raw)
    return buf.getvalue()


# ------------------------------------------------------------------ scope
def own_scope():
    """Run in our own systemd scope (app-dictate-<pid>.scope), not inside GNOME Shell's cgroup:
    system monitors then show the CPU and memory of dictation as "dictate", not as GNOME Shell's.
    stdin/stdout pipes survive (systemd-run --scope execs in place)."""
    try:
        with open("/proc/self/cgroup") as f:
            cg = f.read()
    except OSError:
        return
    rt = os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}"
    if "/app-dictate-" in cg or os.environ.get("DICTATE_IN_SCOPE") or not shutil.which("systemd-run") \
            or not os.path.exists(os.path.join(rt, "systemd", "private")):
        return                                      # no systemd user manager: stay where we are
    os.environ["DICTATE_IN_SCOPE"] = "1"
    try:
        os.execvp("systemd-run", ["systemd-run", "--user", "--scope", "--quiet", "--collect", "--slice=app.slice",
                                  f"--unit=app-dictate-{os.getpid()}.scope", "--", sys.executable, "-I",
                                  os.path.abspath(__file__)] + sys.argv[1:])
    except OSError as e:
        log(f"own scope failed: {e}")              # carry on in the current cgroup


# ------------------------------------------------------------------ local speech recognition
class Recognizer:
    """The speech model runs in a separate process (ASR_SCRIPT --worker), started when the recording
    starts so the model (~1.8 s to load) is ready when the speaking ends, and gone afterwards (its
    0.7-2.3 GB of memory are only used while dictating). In a container (podman/docker, image
    dictate-asr): no network, no access to your files (only the model folder, read-only), no
    capabilities, its output is not logged anywhere."""

    def __init__(self):
        self.proc = None
        self.via = self.variant = None
        self.ready = None              # load time once the worker said ready
        self.done = False              # closed for good (recording over or cancelled): no new worker
        self.waited = 0.0              # how long the first request waited for the model to load

    def start(self):
        """Starts the worker without waiting for it (the recording must not be delayed)."""
        if self.done:
            raise Fail("Cancelled")
        if self.proc:
            return
        try:
            with open(ASR_SCRIPT) as f:
                code = f.read()
        except OSError:
            raise Fail("Speech model program missing") from None
        variant = model_variant()
        if not variant:
            raise Fail(MODEL_MISSING)
        via = runtime()
        prefix, model = sandbox(via)
        threads = speech()["threads"]
        cmd = prefix + ["-c", code, "--worker", model] + (["--threads", str(threads)] if threads else []) \
            + (["--fp32"] if variant == "fp32" else [])
        try:
            self.proc = subprocess.Popen(cmd, stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                                         stderr=subprocess.DEVNULL)
        except OSError as e:
            raise Fail(f"Speech model failed to start ({type(e).__name__})") from None
        self.via, self.variant, self.ready = via, variant, None

    @staticmethod
    def _line(proc, timeout):
        """One JSON line from the worker; None if nothing within timeout (or it ended)."""
        if timeout is not None:
            sel = selectors.DefaultSelector()
            sel.register(proc.stdout, selectors.EVENT_READ)
            if not sel.select(timeout):
                return None
        line = proc.stdout.readline()
        if not line:
            return {}
        try:
            return json.loads(line)
        except ValueError:
            return {}

    @staticmethod
    def _kill(proc, loaded=True):
        """A loaded worker ends at end of input; one still loading is stopped right away."""
        try:
            proc.stdin.close()
        except OSError:
            pass
        if not loaded:
            proc.terminate()                      # podman passes it on to the container
        try:
            proc.wait(3)
        except subprocess.TimeoutExpired:
            proc.kill()
            proc.wait()

    def _wait_ready(self):
        """Starts the worker if needed and waits until the model is loaded."""
        self.start()
        if self.ready is None:
            t0 = time.monotonic()
            first = self._line(self.proc, LOAD_TIMEOUT_S)
            if not first or first.get("ready") is not True:
                self.close()
                raise Fail("Speech model failed to start")
            self.ready = first.get("load_s")
            self.waited = time.monotonic() - t0

    def request(self, raw, settings):
        """One piece of a recording (Streamer). Returns the worker's answer (parakeet.py, lang
        "pieces"), checked: {"cands": {code: [text, score]}, "main": code, "asr_s": s, "note": str}."""
        self._wait_ready()
        try:
            self.proc.stdin.write(json.dumps({"n": len(raw), "lang": "pieces", "langs": settings["languages"],
                                              "gate_db": GATE_DB[settings["voice_gate"]]}).encode() + b"\n")
            self.proc.stdin.write(raw)
            self.proc.stdin.flush()
        except (OSError, ValueError, AttributeError):    # closed meanwhile by close() (cancel)
            self.close()
            raise Fail("Speech model stopped") from None
        res = self._line(self.proc, 60 + len(raw) / 2 / RATE)
        if not valid_answer(res):
            err = res.get("error") if isinstance(res, dict) else None
            log(f"model error via {self.via}: {err if isinstance(err, str) else 'no valid answer'}"[:300])
            self.close()
            raise Fail("Transcription failed")
        return res

    def close(self, done=False):
        """Stops the worker; done: for good, so a piece still on its way cannot start a new one."""
        self.done = self.done or done
        if self.proc:
            self._kill(self.proc, self.ready is not None)
        self.proc, self.ready = None, None


def valid_answer(res):
    """The worker's answer to a piece has exactly the expected shape. It runs in a sandbox, but its
    output is still treated as untrusted input: anything else is an error, never used."""
    if not isinstance(res, dict) or "error" in res:
        return False
    cands, main = res.get("cands"), res.get("main")
    return (isinstance(cands, dict) and 0 < len(cands) <= len(LANGS) + 1 and main in cands
            and all(isinstance(c, str) and isinstance(v, list) and len(v) == 2 and isinstance(v[0], str)
                    and len(v[0]) <= MAX_TEXT and isinstance(v[1], (int, float)) and math.isfinite(v[1])
                    for c, v in cands.items())
            and isinstance(res.get("asr_s", 0), (int, float)) and isinstance(res.get("note", ""), str))


class Streamer:
    """Transcribes a recording in pieces WHILE you speak, so the text is there about a second after you
    stop, however long you spoke (before: 90 s of speech = 6+ s of waiting after the stop).
    Audio comes in as it is recorded (feed). As soon as there is a pause (PAUSE_S of silence) and the
    piece is at least MIN_PIECE_S long, the piece is cut in the middle of the pause and sent to the
    speech model, already loaded, which works on it in a background thread while you go on speaking.
    When you stop, only the last piece is left.
    Why pieces of 10..30 s (tested on real Ukrainian dictation): one long piece (a minute or more)
    drops whole phrases; ~5 s pieces give worse words (too little context); 10-25 s were best.
    Silence: pieces are trimmed to EDGE_S of silence at both ends, and a piece with almost no voice is
    not sent at all (from noise the model invents words, e.g. "Well yeah, I'm definitely").
    Language: each piece comes back decoded in every candidate language (parakeet.py, lang "pieces");
    the language is chosen once, from the scores summed over the whole recording, because one short
    piece is too little to tell Ukrainian from Russian.
    Also used for Retry: the whole recording is fed at once and cut into the same pieces."""
    FRAME = 640                       # 20 ms of s16 mono
    MIN_PIECE_S = 10.0
    PAUSE_S = 0.5                     # a pause that ends a piece of MIN_PIECE_S or more
    LONG_PIECE_S = 20.0
    SHORT_PAUSE_S = 0.25              # ...and of LONG_PIECE_S or more
    MAX_PIECE_S = 30.0                # no pause at all: cut at the quietest 0.2 s of the last 10 s
    SIL_DB = 10.0                     # a frame is silence below the noise floor + this
    EDGE_S = 0.3
    MIN_VOICE_S = 0.25                # less voice than this in a piece: not sent

    def __init__(self, rec, settings=None):
        import queue
        import threading
        self.rec, self.settings = rec, settings or speech()
        self.buf = bytearray()
        self.db = []                  # loudness per frame in dB, voice band only
        self.band = VoiceBand()
        self.floor, self.floor_at = None, 0
        self.start_f = 0              # first frame of the current piece
        self.pieces = []              # [start byte, end byte, the worker's answer or None]
        self.skipped = 0
        self.error = None
        self.stopped = False
        self.q = queue.Queue()
        self.thread = threading.Thread(target=self._run, daemon=True)
        self.thread.start()

    # -- background thread: one piece after the other, in order
    def _run(self):
        while True:
            item = self.q.get()
            if item is None:
                return
            piece, raw = item
            if self.error or self.stopped:
                continue
            for attempt in (1, 2):                 # the worker died: start a new one, try once more
                try:
                    piece[2] = self.rec.request(raw, self.settings)
                    break
                except Exception as e:             # Fail, or the worker was closed under us (cancel)
                    if attempt == 2 or self.stopped:
                        self.error = e if isinstance(e, Fail) else Fail("Transcription failed")
                        break

    def stop(self):
        """Cancelled or failed: no new work."""
        self.stopped = True
        self.q.put(None)

    # -- cutting
    def _thr(self):
        """Silence threshold: the 10th percentile of the last 30 s, plus SIL_DB (updated every 0.5 s)."""
        n = len(self.db)
        if self.floor is None or n - self.floor_at >= 25:
            recent = sorted(self.db[-1500:])
            self.floor, self.floor_at = recent[len(recent) // 10], n
        return self.floor + self.SIL_DB

    def feed(self, data):
        f0 = len(self.buf) // self.FRAME
        self.buf += data
        for f in range(f0, len(self.buf) // self.FRAME):
            a = array.array("h")
            a.frombytes(self.buf[f * self.FRAME:(f + 1) * self.FRAME])
            self.db.append(10 * math.log10(self.band.power(a) / 32768 ** 2 + 1e-12))
            self._maybe_cut()

    def _maybe_cut(self):
        nf = len(self.db)
        length = (nf - self.start_f) * 0.02
        if length < self.MIN_PIECE_S:
            return
        thr, run = self._thr(), 0
        while run < nf - self.start_f and run < 100 and self.db[nf - 1 - run] < thr:
            run += 1
        if run * 0.02 >= self.PAUSE_S or (length >= self.LONG_PIECE_S and run * 0.02 >= self.SHORT_PAUSE_S):
            self._cut(nf - run // 2)
        elif length >= self.MAX_PIECE_S:
            best, at = None, nf
            for f in range(nf - 500, nf - 10):       # the quietest 0.2 s in the last 10 s
                e = sum(self.db[f:f + 10])
                if best is None or e < best:
                    best, at = e, f + 5
            self._cut(at)

    def _cut(self, end_f, end_byte=None):
        """The piece [start_f, end_f): trimmed, and sent unless it is (almost) only silence."""
        s, e = self.start_f, end_f
        self.start_f = end_f
        thr = self._thr() if self.db else 0
        voiced = [f for f in range(s, min(e, len(self.db))) if self.db[f] >= thr]
        tail = end_byte is not None and end_byte > e * self.FRAME     # the last, partial frame
        if len(voiced) * 0.02 < self.MIN_VOICE_S:
            if e > s or tail:
                self.skipped += 1
            return
        edge = int(self.EDGE_S / 0.02)
        s = max(s, voiced[0] - edge)
        e2 = min(e, voiced[-1] + 1 + edge)
        b0, b1 = s * self.FRAME, (end_byte if tail and e2 == e else e2 * self.FRAME)
        piece = [b0, b1, None]
        self.pieces.append(piece)
        self.q.put((piece, bytes(self.buf[b0:b1])))

    # -- the end
    def finish(self, final):
        """final: the whole recording exactly as kept. Returns (text, note for the log)."""
        t0 = time.monotonic()
        streamed = len(self.pieces)
        if bytes(self.buf) != final[:len(self.buf)]:          # cannot happen; be safe anyway
            log(f"stream mismatch after {len(self.buf) / 2 / RATE:.1f}s, transcribing it all again")
            self.stop()
            self.thread.join()
            fresh = Streamer(self.rec, self.settings)
            fresh.feed(final)
            return fresh.finish(final)
        self.feed(final[len(self.buf):])
        self._cut(len(self.db), len(self.buf))
        self.q.put(None)
        self.thread.join(timeout=120 + len(final) / 2 / RATE)
        if self.thread.is_alive():
            raise Fail("Transcription timed out")
        if self.error:
            raise self.error
        res = [p[2] for p in self.pieces]
        if any(r is None for r in res):
            raise Fail("Transcription failed")
        lens = [(p[1] - p[0]) / 2 / RATE for p in self.pieces]
        text, lnote = self.choose(res, max(sum(lens), 0.1))
        muted = sum(1 for r in res if "muted" in r.get("note", ""))
        note = (f"{lnote}, {len(self.pieces)} pieces ({streamed} during recording, longest "
                f"{max(lens, default=0):.1f}s, {self.skipped} silent skipped"
                f"{f', quieter voices muted in {muted}' if muted else ''}), "
                f"asr {sum(r.get('asr_s', 0) for r in res):.2f}s, text {time.monotonic() - t0:.2f}s after stop")
        return text, note

    def choose(self, res, seconds):
        """(text, log note): the main language unless another candidate is surer, per second summed
        over all pieces, by more than margin plus the model's known lean to it (LANG_BIAS)."""
        if not res:
            return "", "no voice"
        main = res[0]["main"]
        codes = [c for c in res[0]["cands"] if all(c in r["cands"] for r in res)]
        if main not in codes:
            raise Fail("Transcription failed")
        texts = {c: [r["cands"][c][0] for r in res] for c in codes}
        if len(codes) == 1 or all(texts[c] == texts[main] for c in codes):
            pick, lnote = main, ("lang same" if len(codes) > 1 else f"langs {'+'.join(self.settings['languages'])}")
        else:
            score = {c: sum(r["cands"][c][1] for r in res) for c in codes}
            best = max(codes, key=lambda c: score[c])
            diff = (score[best] - score[main]) / seconds
            pick = best if diff > self.settings["margin"] + LANG_BIAS.get((best, main), 0.0) else main
            lnote = f"lang {pick} ({best}-{main} {diff:+.3f}/s)"
        return " ".join(t.strip() for t in texts[pick] if t and t.strip()), lnote


def sandbox(via, folder=MODEL_DIR, writable=False):
    """(argv that starts `python3 -I` for the speech model, where `folder` is seen in there).
    The model never gets the network, in every mode:
      podman/docker  container: no network, no capabilities, read-only, sees only the model folder
      host + bwrap   bubblewrap: no network (own empty network namespace), sees only /usr and the
                     model folder (read-only), not your home folder, own PID/IPC namespaces
      host, no bwrap unshare: no network only (install bubblewrap for the rest)
    No way to cut the network: the model does not start (fail closed).
    writable: the folder can be written (only to convert the model to int8)."""
    if via != "host":
        # the int8 files must belong to you: run as your own user id (podman: mapped, not root)
        user = ((["--userns", "keep-id"] if via == "podman" else []) +
                ["--user", f"{os.getuid()}:{os.getgid()}"]) if writable else []
        return ([via, "run", "--rm", "-i", "--network", "none", "--read-only", *user,
                 "--cap-drop", "all", "--security-opt", "no-new-privileges",
                 "--pull", "never", "--log-driver", "none", "--memory", "8g" if writable else "6g",
                 "-v", f"{folder}:/m:{'rw' if writable else 'ro'},z", ASR_IMAGE, "python3", "-I"], "/m")
    py = sys.executable
    if shutil.which("bwrap"):
        cmd = ["bwrap", "--unshare-all", "--die-with-parent", "--new-session", "--clearenv",
               "--setenv", "PATH", "/usr/bin", "--setenv", "HOME", "/tmp",
               "--ro-bind", "/usr", "/usr", "--symlink", "usr/bin", "/bin", "--symlink", "usr/sbin", "/sbin",
               "--symlink", "usr/lib", "/lib", "--symlink", "usr/lib64", "/lib64",
               "--ro-bind-try", "/etc/ld.so.cache", "/etc/ld.so.cache",
               "--proc", "/proc", "--dev", "/dev", "--tmpfs", "/tmp",
               "--bind" if writable else "--ro-bind", folder, "/m"]
        for d in {sys.prefix, sys.base_prefix}:          # a Python outside /usr: make it visible too
            if not d.startswith("/usr"):
                cmd += ["--ro-bind", d, d]
        for k in ("PARAKEET_THREADS", "PARAKEET_RU_MARGIN"):
            if os.environ.get(k):
                cmd += ["--setenv", k, os.environ[k]]
        return cmd + ["--", py, "-I"], "/m"
    if shutil.which("unshare"):
        return ["unshare", "--net", "--map-current-user", "--", py, "-I"], folder
    raise Fail("No sandbox for the speech model (install bubblewrap)")


