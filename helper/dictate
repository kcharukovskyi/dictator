def runtime():
    try:
        with open(RUNTIME_FILE) as f:
            v = f.read().strip()
        if v in ("host", "podman", "docker"):
            return v
    except OSError:
        pass
    import importlib.util
    if importlib.util.find_spec("onnxruntime") and importlib.util.find_spec("numpy"):
        return "host"
    return "podman" if shutil.which("podman") else "docker"


def wav_pcm(wav):
    with wave.open(io.BytesIO(wav), "rb") as w:
        if w.getframerate() != RATE or w.getsampwidth() != 2 or w.getnchannels() != 1:
            raise Fail("Unexpected audio format")
        return w.readframes(w.getnframes())


def transcribe(wav, seconds, rec=None, streamer=None, settings=None):
    """The text of a whole recording. streamer: the one that got the audio while it was recorded
    (most pieces are done by now); without it the recording is cut into the same pieces here.
    settings: speech settings to use instead of the saved ones (a chosen language)."""
    own = rec is None
    rec = rec or Recognizer()
    settings = settings or speech()
    try:
        raw = wav_pcm(wav)
        if streamer is None:
            streamer = Streamer(rec, settings)
            streamer.feed(raw)
        text, note = streamer.finish(raw)
    finally:
        if own:
            rec.close()
    text = polish(text, settings)
    engine = f", {rec.variant} via {rec.via}, load {rec.ready}s (waited {rec.waited:.1f}s)" if rec.via else ""
    log(f"ok local, {seconds:.1f}s audio, {len(text)} chars, {note}{engine}")
    return text


def keep(wav):
    """Store the recording in RAM (tmpfs) until its text is out."""
    os.makedirs(PENDING_DIR, mode=0o700, exist_ok=True)
    path = os.path.join(PENDING_DIR, time.strftime("rec-%Y%m%d-%H%M%S.wav"))
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    with os.fdopen(fd, "wb") as f:
        f.write(wav)
    return path


def cleanup_old():
    """Delete kept recordings older than keep_minutes, and the whole history when it is off.
    (The extension does the same every minute, also when no dictation runs.)"""
    p = privacy()
    keep_s = p["keep_minutes"] * 60
    for d, everything in ((PENDING_DIR, False), (HISTORY_DIR, not p["history"])):
        try:
            names = os.listdir(d)
        except OSError:
            continue
        for name in names:
            path = os.path.join(d, name)
            audio_off = d == HISTORY_DIR and name.endswith(".wav") and not p["keep_audio"]
            try:
                if everything or audio_off or (keep_s and time.time() - os.path.getmtime(path) > keep_s):
                    os.unlink(path)
            except OSError:
                pass


def remember(path, text, seconds):
    """Keep the text in the history (RAM) for the extension's menu, and the audio too if keep_audio is
    on (else it is deleted); only the newest HISTORY_N stay."""
    os.makedirs(HISTORY_DIR, mode=0o700, exist_ok=True)
    stamp = os.path.basename(path)[:-4]
    save_meta(stamp, {"time": int(os.path.getmtime(path)), "seconds": round(seconds, 1), "text": text})
    if privacy()["keep_audio"]:
        os.replace(path, os.path.join(HISTORY_DIR, stamp + ".wav"))
    else:
        os.unlink(path)
    stamps = sorted(n[:-5] for n in os.listdir(HISTORY_DIR) if n.endswith(".json"))
    for old in stamps[:-HISTORY_N]:
        for ext in (".json", ".wav"):
            discard(os.path.join(HISTORY_DIR, old + ext))


def save_meta(stamp, meta):
    """Write a history entry's text and numbers, atomically (the extension may read it meanwhile)."""
    tmp = os.path.join(HISTORY_DIR, f".{stamp}.tmp")
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        json.dump(meta, f, ensure_ascii=False)
    os.replace(tmp, os.path.join(HISTORY_DIR, stamp + ".json"))


def discard(path):
    try:
        os.unlink(path)
    except FileNotFoundError:
        pass


